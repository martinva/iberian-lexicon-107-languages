<dictionary>
  <!-- {{{ symbols and stuff -->
  <alphabet/>
  <sdefs>
    <sdef n="abbr" c="Abbr=Yes"/>
    <sdef n="acc" c="Case=Acc"/>
    <sdef n="acr"  c="Abbr=Yes"/>
    <sdef n="ade" c="Case=Ade"/> <!-- this week.adv <-> tämä.prn.ade viikko.n.ade -->
    <sdef n="adj"  c="ADJ"/>
    <sdef n="adv"  c="ADV"/>
    <sdef n="al"  c="PropnType=Unk"/>
    <sdef n="an"  c="???"/>
    <sdef n="ant" c="PropnType=Ant"/>
    <sdef n="apos" c="PunctType=apos"/>
    <sdef n="card" c="NumType=Card"/>
    <sdef n="cm"  c="PunctType=Cm"/>
    <sdef n="cnjadv"  c="SCONJ"/>
    <sdef n="cnjcoo"  c="CCONJ"/>
    <sdef n="cnjsub"  c="SCONJ"/>
    <sdef n="cog" c="PropnType=Cog"/>
    <sdef n="def"  c="Definite="/>
    <sdef n="dem" c="PronType=Dem"/>
    <sdef n="det"  c="DET"/>
    <sdef n="enc"  c="Clitic=ko"/>
    <sdef n="ess"  c="Case=Ess"/> <!-- this year.adv <-> tämä.prn.ess vuosi.n.ess -->
    <sdef n="f" c="PropnType=Fem"/>
    <sdef n="frm" c="formal"/>
    <sdef n="gen" c="Case=Gen"/>
    <sdef n="ger" c="VerbForm=Ger"/>
    <sdef n="guio" c="PUNCT"/>
    <sdef n="ij"  c="INTJ"/>
    <sdef n="ill" c="Case=Ill"/> <!-- in west.adv <-> länsi.n.ill -->
    <sdef n="ind"  c="PronType=Ind"/>
    <sdef n="ine"  c="Case=Ine"/>
    <sdef n="ins"  c="Case=Ins"/> <!--  -->
    <sdef n="itg" c="PronType=Itner"/>
    <sdef n="lpar" c="PUNCT"/>
    <sdef n="lquest"   c="PUNCT"/>
    <sdef n="lquot" c="PUNCT"/>
    <sdef n="m" c="PropnType=Male"/>
    <sdef n="mf" c="PropnType=_"/>
    <sdef n="n"  c="NOUN"/>
    <sdef n="ND"  c="Number=_"/>
    <sdef n="neg"  c="Polarity=Neg"/>
    <sdef n="nn"  c="I don't thinke anyone knows these really..."/>
    <sdef n="nom" c="Case=Nom"/>
    <sdef n="np" c="PROPN"/>
    <sdef n="nt" c="Gender=Neut"/>
    <sdef n="num"  c="NUM"/>
    <sdef n="obj"  c="Case=Acc"/>
    <sdef n="ord" c="Numtupe=Ord"/>
    <sdef n="p1" c="Person=1"/>
    <sdef n="p2" c="Person=2"/>
    <sdef n="p3" c="Person=3"/>
    <sdef n="par" c="Case=Par"/> <!--  -->
    <sdef n="part"  c="PART"/>
    <sdef n="pers" c="PronType=Pers"/>
    <sdef n="pl" c="Number=Plur"/>
    <sdef n="pos" c="Degree=Pos"/>
    <sdef n="post"  c="AdpType=Post"/>
    <sdef n="pr"  c="AdpType=Pre"/>
    <sdef n="preadv"  c="ADV"/>
    <sdef n="predet" c="DET"/>
    <sdef n="prn"  c="PRON"/>
    <sdef n="pron" c="PRON"/>
    <sdef n="punct" c="PUNCT"/>
    <sdef n="pxsp3" c="Person[psor]=3"/> <!--  -->
    <sdef n="qnt"  c="PronType=Ind"/>
    <sdef n="qst" c="Clitic=Ko"/>
    <sdef n="qu"  c="PronType=Ind"/>
    <sdef n="quot" c="PUNCT"/>
    <sdef n="ref" c="Reflex=Yes"/>
    <sdef n="rel"  c="PronType=Rel"/>
    <sdef n="rpar" c="PUNCT"/>
    <sdef n="rquot" c="PUNCT"/>
    <sdef n="sent"  c="PUNCT"/>
    <sdef n="sg" c="Number=Sing"/>
    <sdef n="sint"  c="AdjType=Sint"/>
    <sdef n="sp"  c="Number=_"/>
    <sdef n="subj"  c="Case=Nom"/>
    <sdef n="subst" c="???"/>
    <sdef n="sym"  c="SYM"/>
    <sdef n="tn" c="???"/>
    <sdef n="top" c="PropnType=Top"/>
    <sdef n="tra" c="Case=Tra"/> <!-- in latin.adv <-> latin.n.tra -->
    <sdef n="vaux" c="apuverbi"/>
    <sdef n="vbdo"  c="AUX"/>
    <sdef n="vbhaver"  c="AUX"/>
    <sdef n="vblex"  c="VERB"/>
    <sdef n="vbmod" c="AUX"/>
    <sdef n="vbser"  c="AUX"/>
    <sdef n="x" c="X"/>
  </sdefs>
  <!-- }}}
       -->
  <section id="main" type="standard">


    <!-- {{{ SECTION: Special cases, POS changes
         {{{ PROBLEMS oblems -->

    <e><p><l>molemmat<s n="n"/></l><r>both<s n="adv"/></r></p></e>
    <e><p><l>eikä<s n="adv"/></l><r>nor<s n="cnjcoo"/></r></p></e>
    <e><p><l>kuinkahan<s n="cnjsub"/></l><r>how<s n="preadv"/></r></p></e>
    <e><p><l>pari<s n="num"/></l><r>couple<s n="n"/></r></p></e>

    <!-- n ↔ adj confusions -->

    <e><p><l>läpimittainen<s n="adj"/></l><r>diameter<s n="n"/></r></p></e>
    <e><p><l>mahdollinen<s n="adj"/></l><r>possible<s n="n"/></r></p></e>
    <e><p><l>monisoluinen<s n="adj"/></l><r>multi-cell<s n="n"/></r></p></e>
    <e><p><l>yksisoluinen<s n="adj"/></l><r>single<b/>cell<s n="n"/></r></p></e>
    <e><p><l>kivikautinen<s n="adj"/></l><r>stone<b/>age<s n="n"/></r></p></e>
    <e><p><l>ensisijainen<s n="adj"/></l><r>primary<s n="n"/></r></p></e>
    <e><p><l>kesäinen<s n="adj"/></l><r>summer<s n="n"/></r></p></e>

    <!-- particple problems -->

    <e><p><l>hävetä<s n="vblex"/></l><r>be<b/>ashamed<s n="adv"/></r></p></e>
    <e><p><l>kasvanut<s n="adj"/></l><r>grown<s n="vblex"/></r></p></e>
    <e><p><l>kasvanut<s n="adj"/></l><r>grown<s n="vblex"/></r></p></e>

    <!-- ADP ↔ ADV confusion -->

    <e><p><l>keinoin<s n="post"/></l><r>ways<s n="adv"/></r></p></e>
    <e><p><l>kokonaisuudessaan<s n="post"/></l><r>totally<s n="adv"/></r></p></e>
    <e><p><l>kotona<s n="post"/></l><r>home<s n="adv"/></r></p></e>
    <e><p><l>kohdalla<s n="post"/></l><r>instead<s n="adv"/></r></p></e>
    <e><p><l>käsiin<s n="post"/></l><r>hands<s n="adv"/></r></p></e>
    <e><p><l>lailla<s n="post"/></l><r>like<s n="adv"/></r></p></e>
    <e><p><l>muodossa<s n="post"/></l><r>formally<s n="adv"/></r></p></e>
    <e><p><l>näkökulmasta<s n="post"/></l><r>according<s n="adv"/></r></p></e>
    <e><p><l>osalta<s n="post"/></l><r>behalf<s n="adv"/></r></p></e>
    <e><p><l>pitkälle<s n="post"/></l><r>afar<s n="adv"/></r></p></e>
    <e><p><l>polvilleen<s n="post"/></l><r>aknee<s n="adv"/></r></p></e>
    <e><p><l>puolella<s n="post"/></l><r>side<s n="adv"/></r></p></e>
    <e><p><l>seurauksena<s n="post"/></l><r>resulting<s n="adv"/></r></p></e>
    <e><p><l>sijasta<s n="post"/></l><r>instead<s n="adv"/></r></p></e>
    <e><p><l>sisään<s n="post"/></l><r>inside<s n="adv"/></r></p></e>
    <e><p><l>sivulla<s n="post"/></l><r>aside<s n="adv"/></r></p></e>
    <e><p><l>sivusta<s n="adv"/></l><r>aside<s n="adv"/></r></p></e>
    <e><p><l>suunnilleen<s n="post"/></l><r>approximately<s n="adv"/></r></p></e>
    <e><p><l>tapauksessa<s n="post"/></l><r>then<s n="adv"/></r></p></e>
    <e><p><l>tilalle<s n="post"/></l><r>instead<s n="adv"/></r></p></e>
    <e><p><l>ulkopuolella<s n="post"/></l><r>outside<s n="adv"/></r></p></e>
    <e><p><l>verratuna<s n="post"/></l><r>comparably<s n="adv"/></r></p></e>
    <e><p><l>voimaan<s n="post"/></l><r>in<b/>effect<s n="adv"/></r></p></e>
    <e><p><l>välttämättä<s n="post"/></l><r>disregarding<s n="adv"/></r></p></e>
    <e><p><l>yläpuolelle<s n="post"/></l><r>above<s n="adv"/></r></p></e>
    <e><p><l>kahdestaan<s n="post"/></l><r>together<s n="adv"/></r></p></e>
    <e><p><l>nimeltä<s n="post"/></l><r>named<s n="adv"/></r></p></e>
    <e><p><l>entisestään<s n="post"/></l><r>even<b/>moreso<s n="adv"/></r></p></e>
    <e><p><l>tarkalleen<s n="post"/></l><r>exactly<s n="adv"/></r></p></e>
    <e><p><l>paikallaan<s n="post"/></l><r>in<b/>place<s n="adv"/></r></p></e>
    <e><p><l>vallalla<s n="post"/></l><r>in<b/>place<s n="adv"/></r></p></e>
    <e><p><l>laidalta<s n="post"/></l><r>aside<s n="adv"/></r></p></e>
    <e><p><l>pahimmillaan<s n="post"/></l><r>at<b/>worst<s n="adv"/></r></p></e>
    <e><p><l>vallassa<s n="post"/></l><r>in<b/>power<s n="adv"/></r></p></e>
    <e><p><l>lopulla<s n="post"/></l><r>finally<s n="adv"/></r></p></e>

    <!-- ADV ↔ ADP confusions -->

    <e><p><l>kunnes<s n="adv"/></l><r>until<s n="pr"/></r></p></e>

    <!-- prn ↔ det confusions -->

    <e r="RL"><p><l>muutama<s n="prn"/></l><r>a<b/>few<s n="det"/><s n="qnt"/></r></p></e>
    <e r="RL"><p><l>usea<s n="prn"/></l><r>a<b/>lot<b/>of<s n="det"/><s n="qnt"/></r></p></e>
    <e r="RL"><p><l>usea<s n="prn"/></l><r>lots<b/>of<s n="det"/><s n="qnt"/></r></p></e>
    <e r="RL"><p><l>yhtä<b/>paljon<s n="prn"/></l><r>as<b/>much<s n="det"/><s n="qnt"/></r></p></e>
    <e r="RL"><p><l>moniko<s n="prn"/></l><r>how<b/>many<s n="det"/><s n="itg"/></r></p></e>
    <e r="RL"><p><l>moniko<s n="prn"/></l><r>how<b/>many<s n="prn"/><s n="itg"/></r></p></e>
    <e><p><l>montako<s n="prn"/></l><r>how<b/>many<s n="prn"/><s n="itg"/></r></p></e>
    <e r="RL"><p><l>paljonko<s n="prn"/></l><r>how<b/>much<s n="det"/><s n="itg"/></r></p></e>
    <e r="RL"><p><l>paljonko<s n="prn"/></l><r>how<b/>much<s n="prn"/><s n="itg"/></r></p></e>
    <e r="RL"><p><l>sellainen<s n="prn"/></l><r>such<b/>a<s n="det"/><s n="ind"/></r></p></e>
    <e r="RL"><p><l>yli<b/>puolet<s n="prn"/></l><r>more<b/>than<b/>half<b/>of<s n="det"/><s n="qnt"/></r></p></e>
    <e r="RL"><p><l>niin<b/>moni<s n="prn"/></l><r>so<b/>many<s n="det"/><s n="qnt"/></r></p></e>
    <e r="RL"><p><l>liian<b/>moni<s n="prn"/></l><r>too<b/>many<s n="det"/><s n="qnt"/></r></p></e>
    <e r="RL"><p><l>moni<s n="prn"/></l><r>many<s n="det"/><s n="qnt"/></r></p></e>

    <!-- adv ↔ det -->

    <e r="RL"><p><l>niin<b/>paljon<s n="adv"/></l><r>so<b/>much<s n="det"/></r></p></e>
    <e r="RL"><p><l>enin<s n="adv"/></l><r>most<b/>of<s n="det"/><s n="qnt"/></r></p></e>
    <e r="RL"><p><l>liikaa<s n="adv"/></l><r>too<b/>much<s n="det"/><s n="qnt"/></r></p></e>


    <!-- adj ↔ det -->

    <e r="RL"><p><l>muu<s n="adj"/><s n="pos"/><s n="sg"/></l><r>other<s n="det"/><s n="ind"/><s n="sp"/></r></p></e>

    <!-- with possessions -->

    <e><p><l>minä<s n="prn"/><s n="pers"/><s n="sg"/><s n="gen"/></l><r>my<s n="det"/><s n="pos"/><s n="sp"/></r></p></e>
    <e><p><l>sinä<s n="prn"/><s n="pers"/><s n="p2"/><s n="sg"/><s n="gen"/></l><r>your<s n="det"/><s n="pos"/><s n="sp"/></r></p></e>
    <e><p><l>sinä<s n="prn"/><s n="pers"/><s n="p2"/><s n="sg"/><s n="gen"/></l><r>yours<s n="adj"/><s n="pos"/></r></p></e>
    <e r="RL"><p><l>hän<s n="prn"/><s n="pers"/><s n="p3"/><s n="sg"/><s n="gen"/></l><r>his<s n="det"/><s n="pos"/><s n="sp"/></r></p></e>
    <e r="RL"><p><l>hän<s n="prn"/><s n="pers"/><s n="p3"/><s n="sg"/><s n="gen"/></l><r>his<s n="adj"/><s n="pos"/><s n="sp"/></r></p></e>
    <e r="RL"><p><l>hän<s n="prn"/><s n="pers"/><s n="p3"/><s n="sg"/><s n="gen"/></l><r>her<s n="det"/><s n="pos"/><s n="sp"/></r></p></e>
    <e><p><l>me<s n="prn"/><s n="pers"/><s n="p1"/><s n="pl"/><s n="gen"/></l><r>our<s n="det"/><s n="pos"/><s n="sp"/></r></p></e>
    <e><p><l>he<s n="prn"/><s n="pers"/><s n="p3"/><s n="pl"/><s n="gen"/></l><r>their<s n="det"/><s n="pos"/><s n="sp"/></r></p></e>
    <e><p><l>he<s n="prn"/><s n="pers"/><s n="p3"/><s n="pl"/><s n="gen"/></l><r>their<s n="det"/><s n="pos"/><s n="p3"/><s n="mf"/><s n="pl"/></r></p></e>
    <e><p><l>se<s n="prn"/><s n="pers"/><s n="sg"/><s n="gen"/></l><r>its<s n="det"/><s n="pos"/><s n="sp"/></r></p></e>

    <e r="LR"><p><l>hän<s n="prn"/><s n="pers"/><s n="p3"/><s n="sg"/><s n="gen"/></l>
        <r c="GD">their<s n="det"/><s n="pos"/><s n="sp"/></r></p></e>
    <e r="LR"><p><l>he<s n="prn"/><s n="pers"/><s n="p3"/><s n="pl"/><s n="gen"/></l>
        <r>their<s n="det"/><s n="pos"/><s n="pl"/></r></p></e>
    <e r="RL"><p><l>me<s n="prn"/><s n="pers"/><s n="p1"/><s n="pl"/><s n="gen"/></l>
        <r>our<s n="det"/><s n="pos"/><s n="pl"/></r></p></e>

    <e r="RL"><p><l>hän<s n="prn"/><s n="pers"/><s n="p3"/><s n="sg"/><s n="gen"/></l>
        <r>his<s n="adj"/></r></p></e>
    <e r="RL"><p><l>hän<s n="prn"/><s n="pers"/><s n="p3"/><s n="sg"/><s n="gen"/></l>
        <r>hers<s n="adj"/></r></p></e>
    <e r="RL"><p><l>he<s n="prn"/><s n="pers"/><s n="p3"/><s n="pl"/><s n="gen"/></l>
        <r>theirs<s n="adj"/></r></p></e>
    <e r="RL"><p><l>me<s n="prn"/><s n="pers"/><s n="p3"/><s n="pl"/><s n="gen"/></l>
        <r>ours<s n="adj"/></r></p></e>

    <!-- n+case ← ADV -->

    <e c="eng-feil" r="RL"><p><l>luode<s n="n"/><s n="sg"/><s n="ill"/></l><r>northwest<s n="adv"/></r></p></e>
    <e c="eng-feil" r="RL"><p><l>luode<s n="n"/><s n="sg"/><s n="ill"/></l><r>northwestwardly<s n="adv"/></r></p></e>
    <e c="eng-feil" r="RL"><p><l>luode<s n="n"/><s n="sg"/><s n="ill"/></l><r>northwestward<s n="adv"/></r></p></e>

    <!-- }}}
        {{{ Clitics and contraptions
    -->

    <e r="LR"><p><l>ko<s n="qst"/></l><r></r></p></e>
    <e r="RL"><p><l>ko<s n="qst"/></l><r>do<s n="adv"/><s n="itg"/></r></p></e>

    <!-- translating clitics into words kind of works -->

    <e r="LR"><p><l>kaan<s n="enc"/></l><r>neither<s n="adv"/></r></p></e>
    <e r="LR"><p><l>ka<s n="enc"/></l><r>nor<s n="adv"/></r></p></e>
    <e r="LR"><p><l>kin<s n="enc"/></l><r>also<s n="adv"/></r></p></e>
    <e r="LR"><p><l>pa<s n="enc"/></l><r>indeed<s n="adv"/></r></p></e>
    <e r="LR"><p><l>han<s n="enc"/></l><r>indeed<s n="adv"/></r></p></e>
    <e r="LR"><p><l>s<s n="enc"/></l><r>please<s n="ij"/></r></p></e>

    <e r="RL"><p><l>ja<s n="cnjcoo"/>ei<s n="vblex"/></l><r>nor<s n="cnjcoo"/></r></p></e>

    <!-- other ways -->

    <e r="RL"><p><l>olla<s n="vaux"/></l><r>'s<s n="gen"/></r></p></e>
    <e r="RL"><p><l>olla<s n="vaux"/></l><r>'<s n="gen"/></r></p></e>
    <e r="RL"><p><l>olla<s n="vaux"/></l><r>s'<s n="gen"/></r></p></e>

    <!-- }}}
         {{{ determiners -->


    <!-- articles -->

    <e><p><l>yksi<s n="det"/><s n="sg"/></l><r>a<s n="det"/><s n="ind"/><s n="sg"/></r></p></e>
    <e><p><l>yksi<s n="det"/><s n="pl"/></l><r>some<s n="det"/><s n="qnt"/><s n="sp"/></r></p></e>
    <e><p><l>se<s n="det"/><s n="sg"/></l><r>the<s n="det"/><s n="def"/><s n="sp"/></r></p></e>
    <e><p><l>se<s n="det"/><s n="sg"/></l><r>that<s n="det"/><s n="dem"/><s n="sg"/></r></p></e>
    <e><p><l>ne<s n="det"/><s n="pl"/></l><r>that<s n="det"/><s n="dem"/><s n="pl"/></r></p></e>
    <e><p><l>se<s n="prn"/></l><r>that<s n="det"/><s n="dem"/></r></p></e>



    <!-- }}}
        }}}
        {{{ SECTION: Pronouns      -->

    <!-- {{{ some specific complexities -->

    <e><p><l>mikä<s n="prn"/></l><r>what<s n="prn"/><s n="itg"/><s n="mf"/><s n="sp"/></r></p></e>
    <e><p><l>mikä<s n="prn"/></l><r>what<s n="prn"/><s n="rel"/><s n="nn"/><s n="mf"/></r></p></e>
    <e><p><l>nuo<s n="prn"/></l><r>that<s n="prn"/><s n="dem"/><s n="pl"/></r></p></e>
    <e><p><l>nuo<s n="prn"/></l><r>those<s n="prn"/></r></p></e>
    <e><p><l>nuo<s n="prn"/><s n="dem"/><s n="pl"/><s n="nom"/></l><r>that<s n="prn"/><s n="tn"/><s n="pl"/></r></p></e>
    <e><p><l>tuo<s n="prn"/></l><r>that<s n="prn"/></r></p></e>
    <e><p><l>tuo<s n="prn"/></l><r>that<s n="prn"/><s n="dem"/><s n="mf"/><s n="sg"/></r></p></e>
    <e><p><l>tuo<s n="prn"/><s n="dem"/><s n="sg"/><s n="nom"/></l><r>that<s n="prn"/><s n="tn"/><s n="sg"/></r></p></e>
    <e><p><l>tuo<s n="prn"/><s n="dem"/><s n="sg"/><s n="nom"/></l><r>that<s n="prn"/><s n="tn"/><s n="sg"/></r></p></e>
    <e><p><l>tämä<s n="prn"/><s n="sg"/></l><r>this<s n="det"/><s n="dem"/><s n="sg"/></r></p></e>
    <e><p><l>nämä<s n="prn"/><s n="pl"/></l><r>this<s n="det"/><s n="dem"/><s n="pl"/></r></p></e>
    <e><p><l>nämä<s n="prn"/></l><r>this<s n="prn"/><s n="dem"/><s n="mf"/><s n="pl"/></r></p></e>
    <e><p><l>nämä<s n="prn"/><s n="pl"/></l><r>this<s n="prn"/><s n="dem"/><s n="mf"/><s n="pl"/></r></p></e>

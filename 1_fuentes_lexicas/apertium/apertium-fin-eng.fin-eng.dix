    <e><p><l>/<s n="abbr"/></l><r>/<s n="sent"/></r></p></e>
    <e><p><l>/<s n="n"/></l><r>/<s n="sent"/></r></p></e>
    <e><p><l>/<s n="sym"/></l><r>/<s n="sent"/></r></p></e>
    <e><p><l>_<s n="sym"/></l><r>_<s n="sent"/></r></p></e>
    <e><p><l>/<s n="punct"/></l><r>/<s n="sent"/></r></p></e>
    <e><p><l>#<s n="punct"/></l><r>#<s n="sent"/></r></p></e>
    <e><p><l>%<s n="punct"/></l><r>%<s n="sent"/></r></p></e>
    <e><p><l>%<s n="sym"/></l><r>%<s n="sent"/></r></p></e>

    <!-- weird eng_feil -->

    <e><p><l>"<s n="punct"/></l><r>parquote<s n="quot"/></r></p></e>
    <e><p><l>"<s n="punct"/></l><r>parquote<s n="quot"/></r></p></e>
    <e><p><l>”<s n="punct"/></l><r>parquot<s n="quot"/></r></p></e>

    <!-- symbols -->

    <e><p><l>+<s n="sym"/></l><r>+<s n="sent"/></r></p></e>
    <e><p><l>%<s n="sym"/><s n="n"/></l><r>%<s n="sent"/></r></p></e>
    <e><p><l>:<s n="sym"/></l><r>:<s n="sent"/></r></p></e>
    <e><p><l>Φ<s n="sym"/></l><r>Φ<s n="sent"/></r></p></e>
    <e><p><l>―<s n="sym"/></l><r>―<s n="guio"/></r></p></e>
    <e><p><l>&amp;<s n="sym"/><s n="abbr"/></l><r>&amp;<s n="sent"/></r></p></e>


    <!-- }}}
        }}}
        {{{ SECITON: regexes
           {{{ digit loop -->

    <!-- just digits -->

    <e><re>[0-9]+</re><p><l><s n="num"/><s n="card"/></l><r><s n="num"/></r></p></e>
    <e r="RL"><re>[0-9]+</re><p><l><s n="num"/><s n="card"/></l><r><s n="adj"/></r></p></e>

    <!-- all other codes -->

    <e><re>[0-9]+[. ][0-9. ]+</re><p><l><s n="num"/></l><r><s n="num"/></r></p></e>

<!-- scores, calculation -->
    <e><re>[0-9]+</re><i>+</i><re>[0-9]+</re><p><l><s n="num"/></l><r><s n="num"/></r></p></e>
    <e><re>[0-9]+</re><i>-</i><re>[0-9]+</re><p><l><s n="num"/></l><r><s n="num"/></r></p></e>
    <e><re>[0-9]+</re><i>–</i><re>[0-9]+</re><p><l><s n="num"/></l><r><s n="num"/></r></p></e>
    <e><re>[0-9]+</re><i>–</i><re>[0-9]+%</re><p><l><s n="num"/></l><r><s n="num"/></r></p></e>

    <!-- decimals , <-> . -->
    <e><re>[0-9]+</re><p><l>,</l><r>.</r></p><re>[0-9]+</re><p><l><s n="num"/></l><r><s n="num"/></r></p></e>

    <!-- percentage hugging in eng -->
    <e><re>[0-9]+</re><p><l><s n="num"/><j/><b/>%<s n="sym"/></l><r>%<s n="num"/></r></p></e>
    <e><re>[0-9]+</re><p><l>,</l><r>.</r></p><re>[0-9]+</re><p><l><s n="num"/><j/><b/>%<s n="sym"/></l><r>%<s n="num"/></r></p></e>


    <!-- ordinals with full stop -->
    <e><re>[0-9]+.</re><p><l><s n="adj"/><s n="ord"/></l><r><s n="num"/></r></p></e>
    <e><re>[0-9]+</re>
      <p><l><b/></l><r>,</r></p>
      <re>[0-9]+.</re>
      <p><l><s n="adj"/><s n="ord"/></l><r><s n="num"/></r></p>
    </e>
    <e><re>[0-9]+</re>
      <p><l><b/></l><r>,</r></p>
      <re>[0-9]+</re>
      <p><l><b/></l><r>,</r></p>
      <re>[0-9]+.</re>
      <p><l><s n="adj"/><s n="ord"/></l><r><s n="num"/></r></p>
    </e>

    <!-- cardinals with space -->
    <e><re>[0-9][0-9]*</re>
      <p><l><b/></l><r>,</r></p>
      <re>[0-9][0-9][0-9]</re>
      <p><l><s n="num"/><s n="card"/></l><r><s n="num"/></r></p>
    </e>

    <!-- and decimals -->
    <e><re>[0-9][0-9]*</re>
      <p><l><b/></l><r>,</r></p>
      <re>[0-9][0-9][0-9]</re>
      <p><l>,</l><r>.</r></p>
      <re>[0-9]+</re>
      <p><l><s n="num"/><s n="card"/></l><r><s n="num"/></r></p>
    </e>

    <!-- clocks -->
    <e><re>[0-9]+:[0-9]+:?[0-9]*</re><p><l><s n="num"/></l><r><s n="num"/></r></p></e>

    <!-- days  -->
    <e><re>[0-9][0-9]?[.][0-9][0-9]?[.]</re><p><l><s n="num"/></l><r><s n="num"/></r></p></e>
    <e><re>[0-9][0-9]?[.][0-9][0-9]?[.][0-9][0-9][0-9][0-9]</re><p><l><s n="num"/></l><r><s n="num"/></r></p></e>

    <!-- turn one thousand separator space<->, -->
    <e><re>[0-9][0-9]*</re><p><l><b/></l><r>,</r></p><re>[0-9][0-9][0-9]</re><p><l><s n="num"/><s n="card"/></l><r><s n="num"/></r></p></e>
    <!-- hyphenated or minus -->
    <e><re>[0-9][0-9]*</re><p><l><b/></l><r>,</r></p><re>[0-9][0-9][0-9]</re>
      <i>–</i>
      <re>[0-9][0-9]*</re><p><l><b/></l><r>,</r></p><re>[0-9][0-9][0-9]</re>
      <p><l><s n="num"/></l><r><s n="num"/></r></p></e>
    <!-- stuff -->
    <e><re>[0-9][0-9]*</re>
      <p><l><b/></l><r>,</r></p><re>[0-9][0-9][0-9]</re>
      <p><l>,</l><r>.</r></p><re>[0-9]*</re>
      <p><l><s n="num"/><s n="card"/></l><r><s n="num"/></r></p></e>

    <!-- romans -->

    <e><re>[XVILMC][XVILMC]*</re><p><l><s n="num"/></l><r><s n="num"/></r></p></e>
    <e><re>[XVILMC][XVILMC]*</re><p><l><s n="adj"/></l><r><s n="adj"/></r></p></e>
    <e><re>[XVILMCD][XVILMCD]*</re><p><l><s n="adj"/></l><r><s n="num"/></r></p></e>
    <e><re>[xvilmcd][xvilmcd]*</re><p><l><s n="adj"/></l><r><s n="num"/></r></p></e>

    <!-- urls -->

    <e><i>www.</i><re>[a-z.]*</re><i><s n="n"/></i></e>

    <!-- }}} -->

    <!-- }}} -->

    <!-- remove tokenisation fails -->

    <e r="LR" c="Finnish analyser tokenisation failure"><p><l>lla<s n="x"/></l><r/></p></e>
    <e r="LR" c="Finnish analyser tokenisation failure"><p><l>llä<s n="x"/></l><r/></p></e>
    <e r="LR" c="Finnish analyser tokenisation failure"><p><l>lle<s n="x"/></l><r/></p></e>
    <e r="LR" c="Finnish analyser tokenisation failure"><p><l>ssä<s n="x"/></l><r/></p></e>
    <e r="LR" c="Finnish analyser tokenisation failure"><p><l>ssa<s n="x"/></l><r/></p></e>
    <e r="LR" c="Finnish analyser tokenisation failure"><p><l>tä<s n="x"/></l><r/></p></e>
    <e r="LR" c="Finnish analyser tokenisation failure"><p><l>läinen<s n="n"/></l><r/></p></e>
    <e r="LR" c="Finnish analyser tokenisation failure"><p><l>stä<s n="x"/></l><r/></p></e>
    <e r="LR" c="Finnish analyser tokenisation failure"><p><l>sta<s n="x"/></l><r></r></p></e>
    <e r="LR" c="Finnish analyser tokenisation failure"><p><l>ta<s n="x"/></l><r></r></p></e>
    <e r="LR" c="Finnish analyser tokenisation failure"><p><l>tä<s n="x"/></l><r></r></p></e>
    <e r="LR" c="Finnish analyser tokenisation failure"><p><l>:lla<s n="x"/></l><r/></p></e>
    <e r="LR" c="Finnish analyser tokenisation failure"><p><l>:llä<s n="x"/></l><r/></p></e>
    <e r="LR" c="Finnish analyser tokenisation failure"><p><l>:lle<s n="x"/></l><r/></p></e>
    <e r="LR" c="Finnish analyser tokenisation failure"><p><l>:ssä<s n="x"/></l><r/></p></e>
    <e r="LR" c="Finnish analyser tokenisation failure"><p><l>:ssa<s n="x"/></l><r/></p></e>
    <e r="LR" c="Finnish analyser tokenisation failure"><p><l>:tä<s n="x"/></l><r/></p></e>
    <e r="LR" c="Finnish analyser tokenisation failure"><p><l>:stä<s n="x"/></l><r/></p></e>
    <e r="LR" c="Finnish analyser tokenisation failure"><p><l>:sta<s n="x"/></l><r/></p></e>
    <e r="LR" c="Finnish analyser tokenisation failure"><p><l>:ta<s n="x"/></l><r/></p></e>
    <e r="LR" c="Finnish analyser tokenisation failure"><p><l>:n<s n="x"/></l><r>'s<s n="gen"/></r></p></e>







  </section>
</dictionary>


  <section id="regexp" type="standard">
    <!-- ******************************
          group adv_symbol
      ****************************** -->
<e>       <p><l>at<b/></l>                             <r>a<b/>les<b/></r></p><re>[10]?[0-9]|2[0-4]</re><p><l>:00<s n="adv"/></l><r>.00<b/>h<s n="adv"/></r></p></e>
<e r="LR"><p><l>at<b/></l>                             <r>a<b/>les<b/></r></p><re>[10]?[0-9]|2[0-4]</re><p><l>:00<b/>hours<s n="adv"/></l><r>.00<b/>h<s n="adv"/></r></p></e>
    <!-- ******************************
          group num_symbol
      ****************************** -->
<e>       <re>[0-9]+([.,][0-9]+)?</re><p><l><s n="num"/></l><r><s n="num"/></r></p></e>
<e>       <re>[0-9]+([.,][0-9]+)?%</re><p><l><s n="num"/><s n="percent"/></l><r><s n="num"/><s n="percent"/></r></p></e>
<e r="RL"><re>[0-9]+</re><p><l><s n="adj"/><s n="ord"/></l><r><s n="adj"/><s n="ord"/><s n="m"/><s n="sg"/></r></p></e>
<e r="RL"><re>[0-9]+</re><p><l><s n="adj"/><s n="ord"/></l><r><s n="adj"/><s n="ord"/><s n="m"/><s n="pl"/></r></p></e>
<e r="RL"><re>[0-9]+</re><p><l><s n="adj"/><s n="ord"/></l><r><s n="adj"/><s n="ord"/><s n="f"/><s n="sg"/></r></p></e>
<e r="RL"><re>[0-9]+</re><p><l><s n="adj"/><s n="ord"/></l><r><s n="adj"/><s n="ord"/><s n="f"/><s n="pl"/></r></p></e>
<e r="LR"><re>[0-9]+</re><p><l><s n="adj"/><s n="ord"/></l><r><s n="adj"/><s n="ord"/><s n="GD"/><s n="ND"/></r></p></e>
<e>       <p><l>£</l>                                  <r></r></p><re>[0-9]+([. ,][0-9][0-9][0-9])*([.,][0-9]+)?</re><p><l><s n="num"/><s n="mon"/></l><r>£<s n="num"/><s n="mon"/></r></p></e>
<e>       <p><l>$</l>                                  <r></r></p><re>[0-9]+([. ,][0-9][0-9][0-9])*([.,][0-9]+)?</re><p><l><s n="num"/><s n="mon"/></l><r>$<s n="num"/><s n="mon"/></r></p></e>
<e>       <p><l>€</l>                                  <r></r></p><re>[0-9]+([. ,][0-9][0-9][0-9])*([.,][0-9]+)?</re><p><l><s n="num"/><s n="mon"/></l><r>€<s n="num"/><s n="mon"/></r></p></e>
<e>       <p><l>£</l>                                  <r></r></p><re>[0-9]+([. ,][0-9][0-9][0-9])*([.,][0-9]+)?m</re><p><l><s n="num"/><s n="mon"/></l><r>£<s n="num"/><s n="mon"/></r></p></e>
<e>       <p><l>$</l>                                  <r></r></p><re>[0-9]+([. ,][0-9][0-9][0-9])*([.,][0-9]+)?m</re><p><l><s n="num"/><s n="mon"/></l><r>$<s n="num"/><s n="mon"/></r></p></e>
<e>       <p><l>€</l>                                  <r></r></p><re>[0-9]+([. ,][0-9][0-9][0-9])*([.,][0-9]+)?m</re><p><l><s n="num"/><s n="mon"/></l><r>€<s n="num"/><s n="mon"/></r></p></e>
<e>       <re>[0-9]+[.:][0-5][0-9](pm|PM|am|AM)</re><p><l><s n="num"/></l><r><s n="num"/></r></p></e>
    <!-- ******************************
          group web_symbol
      ****************************** -->
<e>       <re>[a-z.]+@[a-z.]+</re><p><l><s n="web"/></l><r><s n="web"/></r></p></e>
<e>       <re>(((www.)|(http://))[áéíóúàèìòùäëïöüñça-z0-9\-]+([.][áéíóúàèìòùäëïöüñça-z]+)+(/[áéíóúàèìòùäëïöüñça-z0-9_]+)*([.][áéíóúàèìòùäëïöüñça-z]+)*)</re><p><l><s n="web"/></l><r><s n="web"/></r></p></e>
    <!-- ******************************
          group(s) with only one element
      ****************************** -->
<e>       <re>[a-z\-_0-9]+.[a-z0-9]+</re><p><l><s n="n"/><s n="file"/></l><r><s n="n"/><s n="file"/><s n="m"/></r></p></e>
<e>       <p><l>-<s n="guio"/></l>                     <r>-<s n="guio"/></r></p></e>
<e>       <p><l>,<s n="cm"/></l>                       <r>,<s n="cm"/></r></p></e>
<e>       <re>[.\?;:!]</re><p><l><s n="sent"/></l>     <r><s n="sent"/></r></p></e>
<e>       <re>[¿¡]</re><p><l><s n="lquest"/></l>       <r><s n="lquest"/></r></p></e>
<e>       <re>[\(\[]</re><p><l><s n="lpar"/></l>       <r><s n="lpar"/></r></p></e>
<e>       <re>[\)\]]</re><p><l><s n="rpar"/></l>       <r><s n="rpar"/></r></p></e>
<e>       <p><l>'<s n="apos"/></l>                     <r>'<s n="apos"/></r></p></e>
  </section>
  <section id="regexp2" type="standard">
    <!-- ******************************
          group n_symbol
      ****************************** -->
<e r="LR" i="yes"><re>[A-Z][A-Z]</re><p><l><s n="n"/><s n="acr"/><s n="sg"/></l><r><s n="n"/><s n="acr"/><s n="mf"/><s n="sp"/></r></p></e>
